CREATE TABLE `usapostal_2`.`servicios` ( `idservicio` INT NOT NULL AUTO_INCREMENT COMMENT 'numero de servicio' , 
`idempleado` INT NOT NULL COMMENT 'identificación del empleado en tabla empleados' , 
`fecha` DATETIME NOT NULL COMMENT 'fecha de inicio del servicio' , 
`idcliente` VARCHAR(30) NOT NULL COMMENT 'identificación del cliente en tabla clientes' , 
`placa` TEXT NOT NULL COMMENT 'placa del vehiculo que presta el servicio' , 
`guia` INT(12) NOT NULL COMMENT 'puede ser el número de guia puede ser nulo' , 
`planilla` INT(12) NOT NULL COMMENT 'puede ser el número de planilla puede ser nulo' , 
`auxiliar` VARCHAR(50) NOT NULL COMMENT 'tiene relacion con el número de guía o con el número de planilla' , 
`direccionorigen` TEXT NOT NULL COMMENT 'dirección donde se inicia el servicio' , 
`telefonoorigen` INT NOT NULL COMMENT 'telefono donde se inicia el servicio' , 
`idciudadorigen` INT NOT NULL COMMENT 'identificación de la ciudad en tabla municipios' , 
`direcciondestino` TEXT NOT NULL COMMENT 'dirección donde se termina el servicio' , 
`telefonodestino` INT NOT NULL COMMENT 'telefono donde se termina el servicio' , 
`idciudaddestino` INT NOT NULL COMMENT 'identificación de la ciudad en tabla municipios' , 
`cedulapropietario` INT NOT NULL COMMENT 'numero de cédula del propietario' , 
`cedulaconductor` INT NOT NULL COMMENT 'numero de cédula del conductor' , 
`valortotal` INT NOT NULL COMMENT 'valor total del servicio' , 
`valorapagar` INT NOT NULL COMMENT 'valor a pagar por el servicio' ,
PRIMARY KEY (`idservicio`)) ENGINE = InnoDB;

CREATE TABLE `usapostal_2`.`valores` ( `idvalor` INT NOT NULL AUTO_INCREMENT COMMENT 'autoincrementable' , 
`idservicio` INT NOT NULL COMMENT 'identificador del servicio' , 
`valor` INT NOT NULL COMMENT 'valor parcial del total del servicio, tiene relación con valortotal en tabla servicios' , 
`detalle` VARCHAR(50) NOT NULL COMMENT 'donde se explica el por que del valor anterior' , 
PRIMARY KEY (`idvalor`)) ENGINE = InnoDB;

