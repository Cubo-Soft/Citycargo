CREATE TABLE `trasabilidad` (
  `idservicio` int(11) NOT NULL COMMENT 'Numero de servicio creado en la tabla servicios',
  `fecha` datetime NOT NULL COMMENT 'Fecha de creacion del evento en esta tabla',
  `referencia` varchar(50) NOT NULL COMMENT 'Es uno de los tres valores siguientes: numero de guia, numero de planilla u otro',
  `evento` varchar(30) NOT NULL COMMENT 'Pueden ser cinco: creacion, anticipo, pago conductor, factura. Pendiente caja'
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

